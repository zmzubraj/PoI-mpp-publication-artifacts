{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountable_reproducer_identity": {"minLength": 1, "type": "string"},
    "allowed_signers_reference": {"minLength": 1, "type": "string"},
    "decision": {"enum": ["REPRODUCED", "PARTIAL", "NOT_REPRODUCED"]},
    "discrepancy_report_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "independence_basis": {"minLength": 1, "type": "string"},
    "principal": {"minLength": 1, "type": "string"},
    "raw_log_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "reviewed_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "POI_MPP_EXTERNAL_REPRODUCTION_ATTESTATION_V1"},
    "scope_statement": {"minLength": 1, "type": "string"}
  },
  "required": [
    "schema_version",
    "accountable_reproducer_identity",
    "independence_basis",
    "principal",
    "allowed_signers_reference",
    "reviewed_manifest_sha256",
    "raw_log_manifest_sha256",
    "discrepancy_report_sha256",
    "decision",
    "scope_statement"
  ],
  "type": "object"
}
