{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poi-mpp/semantic-evaluator-authority-record.schema.json",
  "title": "POI MPP E3 Semantic Evaluator Authority Record",
  "description": "Schema for a future externally completed E3 semantic evaluator authority record. This schema is not an authority decision and contains no default identity, date, decision, or signature values.",
  "type": "object",
  "required": [
    "schema_version",
    "authority_identity",
    "authority_basis",
    "expertise_scope",
    "authorized_scope",
    "reviewed_artifact_hashes",
    "decision",
    "authorization_date",
    "external_signature_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "POI_MPP_E3_AUTHORITY_RECORD_V1"
    },
    "authority_identity": {
      "type": "string",
      "minLength": 1
    },
    "authority_basis": {
      "type": "string",
      "minLength": 1,
      "description": "Organization, role, or accountable external basis for authority."
    },
    "expertise_scope": {
      "type": "string",
      "minLength": 1
    },
    "authorized_scope": {
      "type": "object",
      "required": [
        "experiment_id",
        "task_class",
        "metric_scope",
        "privacy_scope"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "const": "E3"
        },
        "task_class": {
          "type": "string",
          "minLength": 1
        },
        "metric_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "FAR",
              "FRR",
              "ABSTAIN",
              "coverage",
              "calibration"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "privacy_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "reviewed_artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "LIMITED_SCOPE",
        "DECLINED"
      ]
    },
    "decision_notes": {
      "type": "string"
    },
    "authorization_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "external_signature_required": {
      "type": "boolean",
      "const": true
    },
    "signature_reference": {
      "type": "string",
      "description": "Path or identifier for the detached external signature, stored outside the bundle."
    },
    "allowed_signers_reference": {
      "type": "string",
      "description": "Path or identifier for the trusted allowed-signers registry, stored outside the bundle."
    }
  },
  "additionalProperties": false
}
