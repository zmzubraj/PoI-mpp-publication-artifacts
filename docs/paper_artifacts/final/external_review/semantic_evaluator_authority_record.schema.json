{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poi-mpp/semantic-evaluator-authority-record.schema.json",
  "title": "POI MPP E3 Pre-Execution Semantic Evaluator Authority Record",
  "description": "Schema for a future externally completed and signed E3 pre-execution scope authorization. It cannot attest to E3 results or publication claims.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "authority_identity",
    "authority_basis",
    "expertise_scope",
    "authorized_scope",
    "reviewed_request_manifest",
    "decision",
    "decision_notes",
    "authorization_date",
    "result_attestation_status",
    "external_signature_required",
    "signature_reference",
    "allowed_signers_reference"
  ],
  "properties": {
    "schema_version": {"const": "POI_MPP_E3_AUTHORITY_RECORD_V2"},
    "record_type": {"const": "PRE_EXECUTION_SCOPE_AUTHORIZATION"},
    "authority_identity": {"type": "string", "minLength": 1},
    "authority_basis": {
      "type": "string",
      "minLength": 1,
      "description": "Organization, role, or accountable external basis for authority."
    },
    "expertise_scope": {"type": "string", "minLength": 1},
    "authorized_scope": {
      "type": "object",
      "required": [
        "experiment_id",
        "claim_id",
        "task_class",
        "evidence_origin",
        "metric_scope",
        "artifact_scope",
        "privacy_scope",
        "request_scope_digest"
      ],
      "properties": {
        "experiment_id": {"const": "E3"},
        "claim_id": {"const": "C3"},
        "task_class": {"type": "string", "minLength": 1},
        "evidence_origin": {"const": "REAL_MODEL_EXECUTION"},
        "metric_scope": {
          "type": "array",
          "items": {"enum": ["FAR", "FRR", "ABSTAIN", "coverage", "calibration"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "artifact_scope": {
          "type": "array",
          "items": {"enum": ["T4", "T8", "F7", "RAW_E3_EXECUTION"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "privacy_scope": {"type": "string", "minLength": 1},
        "request_scope_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "reviewed_request_manifest": {
      "type": "object",
      "required": ["path", "sha256", "self_digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "self_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "decision": {"enum": ["APPROVED", "LIMITED_SCOPE"]},
    "decision_notes": {"type": "string", "minLength": 1},
    "authorization_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "result_attestation_status": {"const": "NOT_INCLUDED_PRE_EXECUTION_AUTHORIZATION"},
    "external_signature_required": {"const": true},
    "signature_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for the detached signature stored outside the repository and handoff bundle."
    },
    "allowed_signers_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for the trusted allowed-signers file stored outside the repository and handoff bundle."
    }
  },
  "additionalProperties": false
}
